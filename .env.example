# Copie pra .env e preencha (o .env NUNCA vai pro git).
# O bot le este arquivo do diretorio de trabalho; no Docker ele e montado
# como volume (veja docker-compose.yml) e o Lavalink reaproveita as variaveis.

# ─── ChiBot ───────────────────────────────────────────────
# Token do bot no Discord Developer Portal (obrigatorio).
DISCORD_TOKEN=

# Prefixo dos comandos de texto.
PREFIX=!

# Servidor (guild) onde os slash commands sao registrados na hora.
# Vazio = registro global (pode levar ate ~1h pra propagar).
GUILD_ID=

# ─── Musica (Lavalink) ────────────────────────────────────
# No Docker da VPS use ws://lavalink:2333.
LAVALINK_URI=ws://localhost:2333
LAVALINK_PASSWORD=youshallnotpass

# Chave da YouTube Data API v3 (opcional): melhora a busca por nome.
# Sem ela, a busca cai no ytsearch do Lavalink.
YOUTUBE_API_KEY=

# Login do YouTube (opcional, mas necessario em IP de datacenter):
# deixe vazio e o bot mostra no log o codigo do google.com/device e
# depois salva o refresh token aqui sozinho (veja YtOauth).
# No Docker, ative o OAuth no node com YOUTUBE_OAUTH_ENABLED=true.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=

# ─── Traducao (DeepL) ─────────────────────────────────────
# Chave da API DeepL (Free ou Pro) para o comando /language: as respostas
# sao traduzidas por usuario. Vazio = traducao desligada (tudo em pt).
# A chave da conta Free termina em ':fx'.
DEEPL_API_KEY=

# ─── Harem de jogos (Giant Bomb) ──────────────────────────
# Chave gratuita em giantbomb.com/api (rolls de personagens de jogos).
# Vazio = comandos gamewaifu/gamehusbando/gameroll desligados.
GIANTBOMB_API_KEY=